# Copia este archivo como .env y llena los valores. El .env NUNCA se sube al repo.

# --- Entorno ---
# local (Mac / laptop de desarrollo) o server (Victus)
TW_ENV=local

# --- MongoDB ---
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=cambiar
MONGO_INGESTOR_PASSWORD=cambiar
MONGO_SPARK_PASSWORD=cambiar
MONGO_ANALYST_PASSWORD=cambiar
# Caché de WiredTiger por nodo (GB). 0.25 en local, 0.5 en server.
MONGO_CACHE_GB=0.25

# --- Cassandra ---
CASSANDRA_SUPERUSER_PASSWORD=cambiar
CASSANDRA_SPARK_PASSWORD=cambiar
CASSANDRA_WEB_PASSWORD=cambiar
# Heap por nodo. 512M en local, 1G en server.
CASSANDRA_HEAP=512M

# --- Neo4j ---
NEO4J_PASSWORD=cambiar

# --- Spark ---
# Secreto compartido entre master, workers y jobs
SPARK_SECRET=cambiar
